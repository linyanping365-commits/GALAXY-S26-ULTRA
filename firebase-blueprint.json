{
  "entities": {
    "Card": {
      "title": "Card",
      "description": "Stored credit card details",
      "type": "object",
      "properties": {
        "number": {
          "type": "string",
          "description": "16-digit credit card number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["number", "createdAt"]
    }
  },
  "firestore": {
    "/cards/{cardId}": {
      "schema": "Card",
      "description": "Shared credit card collection where document ID is the 16-digit card number"
    }
  }
}
